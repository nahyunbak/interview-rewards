# Native test assets only: wei and lamports; maximum per interview.
BASE_MAX_REWARD=10000000000000
SOLANA_MAX_REWARD=1000000
# Maximum aggregate reservation per chain; set after funding payout wallets.
BASE_BUDGET=0
SOLANA_BUDGET=0
PAYOUT_ENABLED=false
